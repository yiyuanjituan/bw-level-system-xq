{
  "bracketSpacing": true,
  "singleQuote": true,
  "arrowParens": "avoid",
  "printWidth": 120,
  "singleAttributePerLine": false,
  "endOfLine": "auto",
  "trailingComma": "none",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "*.vue",
      "options": {
        "printWidth": 148
      }
    }
  ]
}
