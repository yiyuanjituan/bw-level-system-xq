  "engines": {
    "node": ">= 20",
    "pnpm": ">= 9"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:web",
    "build:web": "run-s build-only:web type-check",
    "build:app": "run-s build-only:app type-check",
    "preview": "vite preview",
    "build-only": "vite build --mode production --base / --outDir dist",
    "build-only:web": "vite build --mode production --base / --outDir dist",
    "build-only:app": "vite build --mode production --base ./ --outDir dist-app",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "standard-version",
    "prepare": "husky install"
  },
